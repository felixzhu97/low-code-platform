{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": [
      "vitest/globals"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/app/*": [
        "./src/app/*"
      ],
      "@/common/*": [
        "./src/common/*"
      ],
      "@/canvas/*": [
        "./src/canvas/*"
      ],
      "@/component/*": [
        "./src/component/*"
      ],
      "@/template/*": [
        "./src/template/*"
      ],
      "@/theme/*": [
        "./src/theme/*"
      ],
      "@/data/*": [
        "./src/data/*"
      ],
      "@/chart/*": [
        "./src/chart/*"
      ],
      "@/form/*": [
        "./src/form/*"
      ],
      "@/export/*": [
        "./src/export/*"
      ],
      "@/collaboration/*": [
        "./src/collaboration/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
