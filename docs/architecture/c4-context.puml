@startuml 低代码平台 - C4 上下文图
!include ./c4-plantuml/C4_Context.puml

LAYOUT_WITH_LEGEND()

title 系统上下文图 - 低代码平台

Person(developer, "开发者", "使用平台构建应用程序的软件开发者")
Person(designer, "设计师", "创建组件设计的 UI/UX 设计师")
Person(admin, "管理员", "管理用户和资源的平台管理员")

System(lowcode, "低代码平台", "用于构建 Web 应用的可视化拖拽平台") {
    System_Boundary(canvas, "画布子系统") {
        System_Ext(canvas_engine, "画布引擎", "渲染和管理可视化画布")
    }
    System_Boundary(component, "组件子系统") {
        System_Ext(component_lib, "组件库", "存储可复用的 UI 组件")
    }
    System_Boundary(export, "导出子系统") {
        System_Ext(code_generator, "代码生成器", "生成可部署的代码")
    }
}

System_Ext(git, "Git 服务", "导出代码的版本控制")
System_Ext(cdn, "CDN", "提供静态资源和导出代码")
System_Ext(db, "数据库", "存储项目、组件和用户数据")

Rel(developer, lowcode, "创建应用", "Web 浏览器")
Rel(designer, lowcode, "设计组件", "Web 浏览器")
Rel(admin, lowcode, "管理平台", "Web 浏览器")

Rel(lowcode, canvas_engine, "渲染 UI", "内部")
Rel(lowcode, component_lib, "加载组件", "内部")
Rel(lowcode, code_generator, "生成代码", "内部")

Rel(lowcode, db, "存储/获取数据", "PostgreSQL")
Rel(code_generator, git, "版本控制", "Git")
Rel(code_generator, cdn, "部署资源", "HTTPS")

@enduml
