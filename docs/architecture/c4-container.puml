@startuml 低代码平台 - C4 容器图
!include ./c4-plantuml/C4_Container.puml

LAYOUT_WITH_LEGEND()

title 容器图 - 低代码平台

Person(developer, "开发者", "使用平台构建应用的开发者")
Person(designer, "设计师", "UI/UX 设计师")
Person(admin, "管理员", "平台管理员")

System_Boundary(frontend, "前端应用") {
    Container(spa, "单页应用", "Next.js 15", "提供低代码编辑器 UI")
    Container(canvas, "画布引擎", "React 组件", "拖拽画布渲染")
    Container(component_mgr, "组件管理器", "React Hooks", "管理组件注册")
    Container(property_panel, "属性面板", "React 组件", "组件属性编辑")
    Container(theme_editor, "主题编辑器", "React 组件", "主题定制")
    Container(export_mgr, "导出管理器", "React 组件", "代码生成工作流")
    Container(collaboration, "协作服务", "WebSocket", "实时同步")
}

System_Boundary(domain, "领域层") {
    Container(domain_core, "领域核心", "TypeScript", "实体、值对象、聚合")
    Container(domain_events, "领域事件", "TypeScript", "业务事件定义")
    Container(domain_services, "领域服务", "TypeScript", "业务逻辑")
}

System_Boundary(application, "应用层") {
    Container(use_cases, "用例", "TypeScript", "应用服务和命令")
    Container(queries, "查询", "TypeScript", "读操作")
}

System_Boundary(infrastructure, "基础设施层") {
    ContainerDb(repo_impl, "仓储实现", "PostgreSQL", "数据持久化")
    Container(ext_services, "外部服务", "REST", "第三方集成")
    Container(cache, "缓存层", "Redis", "会话和数据缓存")
}

Rel(developer, spa, "使用", "HTTPS")
Rel(designer, spa, "设计", "HTTPS")
Rel(admin, spa, "管理", "HTTPS")

Rel(spa, canvas, "渲染画布")
Rel(spa, component_mgr, "管理组件")
Rel(spa, property_panel, "编辑属性")
Rel(spa, theme_editor, "定制主题")
Rel(spa, export_mgr, "导出代码")
Rel(spa, collaboration, "同步变更")

Rel(spa, use_cases, "执行命令")
Rel(use_cases, domain_core, "领域操作")
Rel(use_cases, domain_events, "发布事件")
Rel(queries, domain_core, "读取领域")

Rel(use_cases, repo_impl, "持久化数据")
Rel(queries, repo_impl, "查询数据")
Rel(use_cases, cache, "缓存数据")
Rel(use_cases, ext_services, "集成")

@enduml
