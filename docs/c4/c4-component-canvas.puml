@startuml Component Diagram - Canvas Module
!include c4-plantuml/C4_Component.puml

LAYOUT_WITH_LEGEND()

title 组件图 - 画布模块 (Canvas Module)

Container(canvas, "Canvas", "React Component", "画布主组件，负责渲染页面布局和组件")
Container(componentTree, "ComponentTree", "React Component", "组件树侧边栏，显示页面组件层级结构")
Container(previewCanvas, "PreviewCanvas", "React Component", "预览模式画布，展示最终效果")
Container(componentRenderer, "ComponentRenderer", "React Component", "组件渲染器，递归渲染各类组件")
Container(dataRenderer, "DataComponentRenderer", "React Component", "数据组件渲染器：表格、列表、卡片、分页、树形控件")
Container(layoutRenderer, "LayoutComponentRenderer", "React Component", "布局组件渲染器：网格、弹性、分栏、标签页等")
Container(chartRenderer, "ChartComponentRenderer", "React Component", "图表组件渲染器：柱状图、折线图、饼图等")

Container(useCanvasDrag, "useCanvasDrag", "React Hook", "拖拽交互Hook，处理组件拖拽放置逻辑")
Container(useComponentInteraction, "useComponentInteraction", "React Hook", "组件交互Hook，处理选择、移动、删除等交互")

Container(componentStore, "ComponentStore", "Zustand Store", "组件状态管理：组件列表、选中状态、增删改操作")
Container(canvasStore, "CanvasStore", "Zustand Store", "画布状态管理：预览模式、网格显示、设备类型、主题")
Container(themeStore, "ThemeStore", "Zustand Store", "主题状态管理：背景色、文字色、字体等")

Container(componentMgmtService, "ComponentManagementService", "Domain Service", "组件管理服务：组件创建、删除、位置更新、根组件获取")
Container(componentFactory, "ComponentFactoryService", "Domain Service", "组件工厂服务：根据类型创建组件实例")
Container(dataBindingService, "DataBindingService", "Domain Service", "数据绑定服务：组件数据绑定、映射、转换")

' Canvas 与子组件的关系
Rel(canvas, componentTree, "显示组件树")
Rel(canvas, previewCanvas, "切换预览模式")
Rel(canvas, componentRenderer, "渲染组件")
Rel(canvas, useCanvasDrag, "使用Hook处理拖拽")
Rel(canvas, useComponentInteraction, "使用Hook处理交互")

' ComponentRenderer 的渲染逻辑
Rel(componentRenderer, dataRenderer, "委托数据组件渲染")
Rel(componentRenderer, layoutRenderer, "委托布局组件渲染")
Rel(componentRenderer, chartRenderer, "委托图表组件渲染")

' Store 依赖关系
Rel(useCanvasDrag, componentStore, "读写组件状态")
Rel(useCanvasDrag, canvasStore, "读取画布配置")
Rel(useComponentInteraction, componentStore, "更新组件状态")
Rel(useComponentInteraction, canvasStore, "读取画布状态")

Rel(componentMgmtService, componentFactory, "创建组件")
Rel(componentMgmtService, dataBindingService, "数据绑定")
Rel(componentMgmtService, componentStore, "操作组件状态")

' 组件与 Store 的关系
Rel(canvas, componentStore, "订阅组件状态")
Rel(canvas, canvasStore, "订阅画布状态")
Rel(canvas, themeStore, "订阅主题状态")
Rel(componentTree, componentStore, "订阅组件状态")
Rel(componentRenderer, themeStore, "读取主题配置")
Rel(componentRenderer, componentStore, "读取组件数据")

@enduml
