@startuml Low-Code Platform C4 Context Diagram
!include ./c4-plantuml/C4_Context.puml

LAYOUT_WITH_LEGEND()

title 系统上下文图 - 低代码平台

' ========== 人员 (Actors) ==========
Person(developer, "开发者", "使用低代码平台构建 Web 应用程序的软件开发者")
Person(designer, "设计师", "在平台上设计可复用组件的 UI/UX 设计师")
Person(admin, "管理员", "管理平台用户、权限和资源配置的系统管理员")

' ========== 低代码平台系统 (Software System) ==========
System(lowcode, "低代码平台", "用于构建 Web 应用的可视化拖拽开发平台，支持组件设计、页面编辑、代码生成和应用导出")

' ========== 外部系统 (External Systems) ==========
System_Ext(browser, "Web 浏览器", "用户访问平台的客户端环境")
System_Ext(cdn, "CDN", "内容分发网络，用于托管和分发静态资源")
System_Ext(git, "Git 服务", "代码版本控制系统，用于存储和管理生成的源代码")

' ========== 人员与平台的关系 ==========
Rel(developer, lowcode, "创建应用", "HTTPS")
Rel(designer, lowcode, "设计组件", "HTTPS")
Rel(admin, lowcode, "管理平台", "HTTPS")
Rel(developer, browser, "访问")
Rel(designer, browser, "访问")
Rel(admin, browser, "访问")

' ========== 平台与外部系统的关系 ==========
Rel(lowcode, browser, "渲染页面", "React/DOM")
Rel(lowcode, cdn, "分发资源", "HTTPS")
Rel(lowcode, git, "推送代码", "Git/HTTPS")

SHOW_LEGEND()
@enduml
