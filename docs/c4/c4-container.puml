@startuml Low-Code Platform C4 Container Diagram
!include ./c4-plantuml/C4_Container.puml

LAYOUT_WITH_LEGEND()

title 容器图 - 低代码平台

' ========== 人员 (Actors) ==========
Person(developer, "开发者", "使用平台构建应用的开发者")
Person(designer, "设计师", "UI/UX 设计师")

' ========== 客户端应用 (Client) ==========
System_Boundary(client, "Web 客户端") {
    Container(spa, "单页应用", "Next.js 15 + React 19", "提供低代码编辑器 UI 界面")
}

' ========== 前端组件层 ==========
System_Boundary(frontend, "前端组件层") {
    Container(canvas_engine, "画布引擎", "React + React DnD", "拖拽画布渲染、组件放置和交互")
    Container(component_mgr, "组件管理器", "React Hooks + Zustand", "组件注册、查找、状态管理")
    Container(property_panel, "属性面板", "React 组件", "组件属性编辑和绑定")
    Container(theme_editor, "主题编辑器", "React 组件", "主题定制和样式管理")
    Container(template_gallery, "模板库", "React 组件", "模板浏览和应用")
    Container(code_export, "代码导出", "React 组件", "代码生成和导出工作流")
    Container(collaboration, "协作服务", "WebSocket", "实时同步和多人协作")
    Container(form_builder, "表单构建器", "React Hook Form + Zod", "表单创建和数据验证")
}

' ========== 数据层 ==========
System_Boundary(data_layer, "数据管理层") {
    Container(data_panel, "数据面板", "Zustand Store", "数据源管理和绑定配置")
    Container(history_mgr, "历史记录管理器", "Zustand + History Service", "撤销/重做操作历史")
    Container(persistence, "持久化管理器", "LocalStorage", "浏览器本地数据持久化")
}

' ========== 业务服务层 ==========
System_Boundary(business, "业务服务层") {
    Container(component_factory, "组件工厂服务", "Domain Service", "组件创建、类型判断、默认属性")
    Container(component_mgmt, "组件管理服务", "Application Service", "组件 CRUD 操作")
    Container(data_binding, "数据绑定服务", "Application Service", "组件与数据源绑定、映射")
    Container(data_source, "数据源服务", "Application Service", "数据源获取、缓存、刷新")
}

' ========== UI 组件库 ==========
System_Boundary(ui_lib, "UI 组件库") {
    Container(basic_ui, "基础 UI 组件", "Radix UI + Tailwind CSS", "按钮、表单、对话框等基础组件")
    Container(charts, "图表组件", "Recharts", "柱状图、折线图、饼图等")
    Container(layout, "布局组件", "React 组件", "网格、Flex、分栏等布局组件")
}

' ========== 外部服务 ==========
System_Ext(cdn, "CDN", "静态资源分发网络")
System_Ext(git, "Git 服务", "代码版本控制")

' ========== 人员与平台的关系 ==========
Rel(developer, spa, "使用编辑器")
Rel(designer, spa, "设计页面")

' ========== SPA 与前端组件层的关系 ==========
Rel(spa, canvas_engine, "渲染画布")
Rel(spa, component_mgr, "管理组件状态")
Rel(spa, property_panel, "编辑属性")
Rel(spa, theme_editor, "定制主题")
Rel(spa, template_gallery, "选择模板")
Rel(spa, code_export, "导出代码")
Rel(spa, form_builder, "构建表单")

' ========== 画布引擎与数据层的关系 ==========
Rel(canvas_engine, component_mgr, "读取组件")
Rel(canvas_engine, persistence, "保存/加载")

' ========== 组件管理与业务服务层的关系 ==========
Rel(component_mgr, component_factory, "创建组件")
Rel(component_mgr, data_binding, "绑定数据")
Rel(data_binding, data_source, "获取数据")
Rel(data_binding, data_panel, "管理数据源")

' ========== 历史记录与组件管理的关系 ==========
Rel(history_mgr, component_mgr, "记录操作")
Rel(history_mgr, canvas_engine, "记录变更")

' ========== UI 组件库的使用 ==========
Rel(canvas_engine, basic_ui, "渲染基础组件")
Rel(canvas_engine, charts, "渲染图表")
Rel(canvas_engine, layout, "渲染布局")

' ========== 协作服务 ==========
Rel(collaboration, canvas_engine, "同步状态")

' ========== 持久化 ==========
Rel(persistence, component_mgr, "持久化组件")

' ========== 代码导出 ==========
Rel(code_export, component_mgr, "获取组件")
Rel(code_export, git, "推送代码")

SHOW_LEGEND()
@enduml
