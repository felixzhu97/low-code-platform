@startuml Component Diagram - Properties Panel Module
!include c4-plantuml/C4_Component.puml

LAYOUT_WITH_LEGEND()

title 组件图 - 属性面板模块 (Properties Panel Module)

Container(propertiesPanel, "PropertiesPanel", "React Component", "属性面板主组件，编辑选中组件的属性")
Container(basicProperties, "BasicProperties", "React Component", "基本属性编辑区：文本、按钮、图片等组件特有属性")
Container(styleProperties, "StyleProperties", "React Component", "样式属性编辑区：宽高、边距、背景色等通用样式")
Container(dataBinding, "DataBinding", "React Component", "数据绑定区：数据源选择和字段映射")
Container(eventBinding, "EventBinding", "React Component", "事件绑定区：点击事件、提交事件等")

Container(componentStore, "ComponentStore", "Zustand Store", "组件状态管理：当前选中组件、组件更新方法")
Container(dataStore, "DataStore", "Zustand Store", "数据源状态管理：可用数据源列表")

' 属性面板结构
Rel(propertiesPanel, basicProperties, "渲染基本属性")
Rel(propertiesPanel, styleProperties, "渲染样式属性")
Rel(propertiesPanel, dataBinding, "渲染数据绑定")
Rel(propertiesPanel, eventBinding, "渲染事件绑定")

' Store 依赖
Rel(propertiesPanel, componentStore, "读取选中组件，更新组件属性")
Rel(propertiesPanel, dataStore, "读取可用数据源")

Rel(basicProperties, componentStore, "更新组件属性")
Rel(styleProperties, componentStore, "更新组件样式")
Rel(dataBinding, componentStore, "绑定数据源")
Rel(dataBinding, dataStore, "获取数据源列表")
Rel(eventBinding, componentStore, "绑定事件处理")

' UI 组件库
Container(accordion, "Accordion", "Shadcn UI", "折叠面板组件")
Container(tabs, "Tabs", "Shadcn UI", "标签页组件：属性/数据/事件")
Container(input, "Input", "Shadcn UI", "输入框组件")
Container(switch, "Switch", "Shadcn UI", "开关组件")
Container(slider, "Slider", "Shadcn UI", "滑块组件")
Container(select, "Select", "Shadcn UI", "选择器组件")
Container(label, "Label", "Shadcn UI", "标签组件")
Container(colorPicker, "ColorPicker", "Shadcn UI", "颜色选择器组件")
Container(scrollArea, "ScrollArea", "Shadcn UI", "滚动区域组件")

Rel(propertiesPanel, accordion, "使用")
Rel(propertiesPanel, tabs, "使用")
Rel(propertiesPanel, input, "使用")
Rel(propertiesPanel, switch, "使用")
Rel(propertiesPanel, slider, "使用")
Rel(propertiesPanel, select, "使用")
Rel(propertiesPanel, label, "使用")
Rel(propertiesPanel, colorPicker, "使用")
Rel(propertiesPanel, scrollArea, "使用")

' 属性类型映射
Container(textProperties, "TextProperties", "Type", "文本属性：内容、字体大小、粗细、颜色、对齐、行高、转换、装饰")
Container(buttonProperties, "ButtonProperties", "Type", "按钮属性：文本、变体、尺寸、禁用、图标、全宽")
Container(imageProperties, "ImageProperties", "Type", "图片属性：地址、替代文本、宽高、填充方式、圆角、阴影、边框")
Container(inputProperties, "InputProperties", "Type", "输入框属性：标签、占位符、默认值、帮助文本、类型、禁用、必填")
Container(cardProperties, "CardProperties", "Type", "卡片属性：标题、阴影、内边距、边框、圆角")
Container(layoutProperties, "LayoutProperties", "Type", "布局属性：网格、弹性、分栏、标签页的特有属性")

Rel(basicProperties, textProperties, "渲染文本属性")
Rel(basicProperties, buttonProperties, "渲染按钮属性")
Rel(basicProperties, imageProperties, "渲染图片属性")
Rel(basicProperties, inputProperties, "渲染输入框属性")
Rel(basicProperties, cardProperties, "渲染卡片属性")
Rel(basicProperties, layoutProperties, "渲染布局属性")

@enduml
