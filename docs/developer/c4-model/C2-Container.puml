@startuml C2-Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title 容器图 (C2) — Explore Lowcode（业务域目录）

Person(developer, "开发者", "使用编辑器构建页面")
Person(designer, "设计师", "设计主题与模板")

System_Boundary(lcp, "Explore Lowcode") {
    Container(spa, "Web SPA", "Next.js + React", "App Router 入口（src/app）")

    Container(domains, "业务域模块", "TS + React", "canvas / component / template / theme / data / chart / form / export / collaboration")
    Container(sharedUi, "components + hooks", "React", "共享 UI kit 与 hooks")
    Container(sharedLib, "lib", "TypeScript", "utils、history、LocalStorage 持久化、store 组合")
}

System_Ext(browser_storage, "Browser LocalStorage", "本地项目状态持久化")
System_Ext(vercel, "Vercel", "生产托管")
System_Ext(cdn, "CDN", "静态资源")

Rel(developer, spa, "使用编辑器", "HTTPS")
Rel(designer, spa, "设计页面", "HTTPS")

Rel(spa, domains, "组合各业务域")
Rel(spa, sharedUi, "共享壳层 UI")
Rel(domains, sharedUi, "使用 primitives")
Rel(domains, sharedLib, "状态 / 工具 / 持久化")
Rel(sharedLib, browser_storage, "save / load", "LocalStorage")

Rel(spa, vercel, "deploy")
Rel(spa, cdn, "assets")

SHOW_LEGEND()
@enduml
