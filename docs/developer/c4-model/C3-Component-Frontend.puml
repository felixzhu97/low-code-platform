@startuml C3-Component-Frontend
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title 组件图 (C3) - Frontend business domains (colocated)

Container_Boundary(canvasB, "canvas") {
    Component(canvas, "Canvas", "React", "主画布")
    Component(propsPanel, "PropertiesPanel", "React", "属性配置")
    Component(canvasStore, "canvas.store", "Zustand", "预览、网格、设备")
}

Container_Boundary(componentB, "component") {
    Component(panel, "ComponentPanel", "React", "组件面板")
    Component(renderer, "ComponentRenderer", "React", "递归渲染")
    Component(compMgmt, "ComponentManagementService", "TS", "CRUD / 移动")
    Component(factory, "ComponentFactoryService", "TS", "默认实例")
    Component(compStore, "component.store", "Zustand", "组件列表与选中")
}

Container_Boundary(templateB, "template") {
    Component(templates, "TemplateGallery", "React", "模板浏览")
    Component(templateSvc, "TemplateService", "TS", "应用模板")
}

Container_Boundary(themeB, "theme") {
    Component(themeEditor, "ThemeEditor", "React", "主题定制")
    Component(themeStore, "theme.store", "Zustand", "主题 token")
}

Container_Boundary(dataB, "data") {
    Component(dataPanel, "DataPanel", "React", "数据源管理")
    Component(dataBinding, "DataBindingService", "TS", "绑定")
    Component(dataSource, "DataSourceService", "TS", "取数")
}

Container_Boundary(sharedB, "components / hooks / lib") {
    Component(uiKit, "components/ui", "React", "shadcn primitives")
    Component(historyStore, "history.store", "Zustand", "历史栈")
    Component(persistence, "PersistenceManager", "TS", "LocalStorage")
}

Rel(canvas, renderer, "渲染节点")
Rel(canvas, panel, "接收拖拽")
Rel(canvas, propsPanel, "编辑选中项")
Rel(templates, canvas, "应用模板")
Rel(themeEditor, themeStore, "更新主题")
Rel(panel, compMgmt, "创建组件")
Rel(compMgmt, factory, "实例化")
Rel(compMgmt, dataBinding, "绑定")
Rel(dataBinding, dataSource, "取数")
Rel(compMgmt, compStore, "写状态")
Rel(canvas, canvasStore, "画布配置")
Rel(persistence, compStore, "持久化")
Rel(canvas, uiKit, "基础控件")

SHOW_LEGEND()
@enduml
