@startuml C3-Component-Frontend
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title 组件图 (C3) - Frontend / Editor Shell

Container_Boundary(presentation, "Presentation") {
    Component(canvas, "Canvas", "React", "主画布：放置、选择、布局")
    Component(preview, "PreviewCanvas", "React", "预览模式")
    Component(tree, "ComponentTree", "React", "组件层级树")
    Component(panel, "ComponentPanel", "React", "左侧组件面板")
    Component(propsPanel, "PropertiesPanel", "React", "右侧属性配置")
    Component(renderer, "ComponentRenderer", "React", "递归渲染 layout/data/chart/form")
    Component(templates, "TemplateGallery", "React", "模板浏览与应用")
    Component(themeEditor, "ThemeEditor", "React", "主题定制")
    Component(formBuilder, "FormBuilder", "React", "表单构建")
    Component(charts, "Charts", "Recharts", "图表组件集")
    Component(codeExport, "CodeExport", "React", "代码导出")
}

Container_Boundary(application, "Application") {
    Component(compMgmt, "ComponentManagementService", "TS", "组件 CRUD / 移动")
    Component(dataBinding, "DataBindingService", "TS", "组件与数据源绑定")
    Component(dataSource, "DataSourceService", "TS", "数据源获取与缓存")
    Component(historySvc, "HistoryService", "TS", "撤销重做支持")
}

Container_Boundary(domainLayer, "Domain") {
    Component(factory, "ComponentFactoryService", "TS", "按类型创建默认实例")
    Component(entities, "Entities / Types", "TS", "Component、ThemeConfig 等")
}

Container_Boundary(sharedLayer, "Shared") {
    Component(compStore, "ComponentStore", "Zustand", "组件列表与选中态")
    Component(canvasStore, "CanvasStore", "Zustand", "预览、网格、设备")
    Component(themeStore, "ThemeStore", "Zustand", "主题 token")
    Component(historyStore, "HistoryStore", "Zustand", "历史栈")
    Component(persistence, "PersistenceManager", "TS", "LocalStorage 读写")
}

Rel(canvas, tree, "显示层级")
Rel(canvas, preview, "切换预览")
Rel(canvas, renderer, "渲染节点")
Rel(canvas, panel, "接收拖拽")
Rel(canvas, propsPanel, "编辑选中项")
Rel(renderer, charts, "图表节点")
Rel(templates, canvas, "应用模板")
Rel(themeEditor, themeStore, "更新主题")
Rel(formBuilder, canvas, "生成表单节点")
Rel(codeExport, compStore, "读取组件树")

Rel(panel, compMgmt, "创建组件")
Rel(canvas, compMgmt, "更新布局")
Rel(compMgmt, factory, "实例化")
Rel(compMgmt, dataBinding, "绑定")
Rel(dataBinding, dataSource, "取数")
Rel(compMgmt, compStore, "写状态")
Rel(canvas, canvasStore, "画布配置")
Rel(historySvc, historyStore, "记录变更")
Rel(persistence, compStore, "持久化")
Rel(factory, entities, "使用类型")

SHOW_LEGEND()
@enduml
