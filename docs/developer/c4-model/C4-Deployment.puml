@startuml C4-Deployment
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

LAYOUT_WITH_LEGEND()

title 部署图 (C4) - Local Development

Deployment_Node(dev_machine, "Developer Machine", "macOS / Linux / Windows") {
    Deployment_Node(node_runtime, "Node.js >= 18", "pnpm") {
        Container(next_dev, "Next.js Dev Server", "next dev", "Hot reload SPA on :3000")
    }
    Deployment_Node(browser, "Browser", "Chrome / Safari / Firefox") {
        Container(spa_client, "Editor SPA", "React 19", "Canvas + panels + stores")
    }
}

Rel(browser, next_dev, "HTTP", "localhost:3000")
Rel(spa_client, next_dev, "HMR / assets")

SHOW_LEGEND()
@enduml
